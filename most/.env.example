# Adresa ERP backenda: lokalno http://localhost:3002, produkcija https://erp-econ-1.onrender.com
ERP_API_URL=https://erp-econ-1.onrender.com
# Zajednička tajna: ista vrijednost mora biti u Renderu kao MOST_TOKEN (najmanje 24 znaka)
MOST_TOKEN=
# Korijen projektnih mapa — upiši s KOSIM crtama (obrnute kose crte Node u .env datoteci briše).
# {godina} se zamjenjuje tekućom godinom i dvjema prethodnima (2027, 2026, 2025); više putanja odvoji s ";". Prazno = ova zadana vrijednost.
KORIJEN_PROJEKTI=Z:/ECON_{godina}/ECON_{godina}/Econ_{godina}_Projekti
# 1 = probni način: rezultat ide u most/proba-izlaz, na Z: se ništa ne piše
MOST_PROBNO=1
# Samo na serveru (servisni račun nema spojen Z:): most sam spoji pogon za svoju sesiju. Dijeljena mapa: Z:=//ECON-R550/econ,
# lokalna mapa na istom računalu: Z:=D:/econ. Na računalu na kojem je Z: već spojen ostaviti prazno.
MAPIRAJ_POGONE=
# Mapa sigurnosnih kopija (ista kao BACKUP_MAPA programa za kopije, npr. Z:/ECON_ERP/Kopije). Most iz nje samo čita stanje kopija
# (zadnja kopija, greška, probna obnova) i javlja ga ERP-u: Direktorski pregled → Stanje servera. Prazno = kopije se ne prate.
MAPA_KOPIJA=
