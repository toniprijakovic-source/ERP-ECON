# Adresa ERP backenda: lokalno http://localhost:3002, produkcija https://erp-econ-1.onrender.com
ERP_API_URL=https://erp-econ-1.onrender.com
# Zajednička tajna: ista vrijednost mora biti u Renderu kao MOST_TOKEN (najmanje 24 znaka)
MOST_TOKEN=
# Korijen projektnih mapa — upiši s KOSIM crtama (obrnute kose crte Node u .env datoteci briše)
KORIJEN_PROJEKTI=Z:/ECON_2026/ECON_2026/Econ_2026_Projekti
# 1 = probni način: rezultat ide u most/proba-izlaz, na Z: se ništa ne piše
MOST_PROBNO=1
