# Kopiraj ovu datoteku u ".env" i popuni stvarne vrijednosti — NIKAD ne commitaj pravi .env u git.

# Connection string iz Supabase (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:LOZINKA@db.xxxxxxxx.supabase.co:5432/postgres

# Bilo koji dugi nasumični niz — koristi se za potpisivanje login tokena.
# Generiraj npr. s: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001

# --- Samo za skripte sigurnosnih kopija (backup-sef.js, provjeri-backup.js, vrati-backup.js); poslužitelj (server.js) ih ne koristi ---
# Lozinka kojom se šifriraju kopije (najmanje 16 znakova, preporuka: slučajna, 30+ znakova). BEZ NJE SE KOPIJE NE MOGU OTVORITI —
# čuvaj je u upravitelju lozinki i u zapečaćenoj kuverti, ne samo u ovoj datoteci.
BACKUP_SIFRA=
# Kamo se spremaju kopije (mape Satne / Dnevne / Mjesecne nastaju same). Ako nije postavljeno, koristi se zadana mapa iz skripte.
BACKUP_MAPA=
